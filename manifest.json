{
  "manifest_version": 3,
  "name": "MomentTabManager",
  "version": "0.1.1",
  "description": "多功能浏览器助手：标签分组去重复制、链接智能预览、文本拖拽搜索翻译，自定义快捷键，提升浏览效率",
  "author": "Moment Team",
  "homepage_url": "https://github.com/moment-team/tab-manager",

  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "sidePanel",
    "declarativeNetRequest"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content-scripts/global-shortcuts.js",
        "content-scripts/text-drag-config.js",
        "content-scripts/platform-list-manager.js",
        "content-scripts/link-preview.js"
      ],
      "css": ["css/link-preview.css"],
      "run_at": "document_idle"
    }
  ],
  
  "action": {
    "default_title": "MomentTabManager",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },



  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "iframe_headers",
        "enabled": true,
        "path": "rules/iframe-rules.json"
      }
    ]
  }
}
